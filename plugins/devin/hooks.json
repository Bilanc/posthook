{
  "PostToolUse": [
    {
      "matcher": "",
      "hooks": [
        { "type": "command", "command": "posthook ingest --agent devin", "timeout": 10 }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "matcher": "",
      "hooks": [
        { "type": "command", "command": "posthook ingest --agent devin", "timeout": 10 }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        { "type": "command", "command": "posthook ingest --agent devin && posthook sync >/dev/null 2>&1", "timeout": 90 }
      ]
    }
  ]
}
